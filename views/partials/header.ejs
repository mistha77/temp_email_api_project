<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <a href="/" class="nav-logo">
    <span class="logo-icon">👻</span>
    <span class="logo-text">Ghost<em>Mail</em></span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">⚡ Generate</a>
    <a href="/inbox" class="nav-link <%= currentPage === 'inbox' ? 'active' : '' %>">
      📥 Inbox
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <span class="nav-badge"><%= unreadCount %></span>
      <% } %>
    </a>
    <a href="/settings" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %>">⚙️ Settings</a>
  </div>
  <% if (currentEmail) { %>
  <div class="nav-email">
    <span class="pulse-dot"></span>
    <code><%= currentEmail %></code>
  </div>
  <% } %>
</nav>
